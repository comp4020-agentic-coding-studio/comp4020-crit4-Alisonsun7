---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="An instrument"
  description="A browser instrument: type a pentatonic melody or drag a theremin glide with mouse or touch — no wrong notes, no score."
>
  <main>
    <h1 class="title">An instrument</h1>
    <canvas id="stage" aria-hidden="true"></canvas>
    <div id="overlay">
      <p>touch, click, drag, or type</p>
      <p class="sub">there's no wrong note</p>
    </div>
  </main>
  <script>
    import "../scripts/instrument";
  </script>
</BaseLayout>
